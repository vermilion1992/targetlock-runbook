{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "types",
    "src/app/(RunbookLayout)/**/*.ts",
    "src/app/(RunbookLayout)/**/*.tsx",
    "src/app/api/**/*.ts",
    "src/app/layout.tsx",
    "src/app/globals.css",
    "src/app/not-found.tsx",
    "src/app/page.tsx",
    "src/application/**/*.ts",
    "src/application/**/*.tsx",
    "src/components/app-shell/**/*.ts",
    "src/components/app-shell/**/*.tsx",
    "src/components/casing/**/*.ts",
    "src/components/casing/**/*.tsx",
    "src/components/components/**/*.ts",
    "src/components/components/**/*.tsx",
    "src/components/field/**/*.ts",
    "src/components/field/**/*.tsx",
    "src/components/holes/**/*.ts",
    "src/components/holes/**/*.tsx",
    "src/components/media/**/*.ts",
    "src/components/media/**/*.tsx",
    "src/components/navigation/**/*.ts",
    "src/components/navigation/**/*.tsx",
    "src/components/reports/**/*.ts",
    "src/components/reports/**/*.tsx",
    "src/components/runs/**/*.ts",
    "src/components/runs/**/*.tsx",
    "src/components/shifts/**/*.ts",
    "src/components/shifts/**/*.tsx",
    "src/components/surveys/**/*.ts",
    "src/components/surveys/**/*.tsx",
    "src/components/trays/**/*.ts",
    "src/components/trays/**/*.tsx",
    "src/components/trajectory/**/*.ts",
    "src/components/trajectory/**/*.tsx",
    "src/domain/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/infrastructure/**/*.tsx",
    "src/lib/**/*.ts",
    "src/middleware.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
