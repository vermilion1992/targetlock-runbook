# TargetLock Runbook — environment variable names only.
# Copy to .env.local for local overrides. Never commit real values.

# ---------------------------------------------------------------------------
# Optional client display base URL (safe for NEXT_PUBLIC_ exposure)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Inherited template AI demos (optional; not required for TargetLock pilot)
# Gemini credentials are server-only.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# In production, inherited template pages and APIs are disabled by default.
ENABLE_TEMPLATE_DEMOS=

# ---------------------------------------------------------------------------
# Optional Railway pilot access gate (server-only; never use NEXT_PUBLIC_)
# Disabled unless PILOT_ACCESS_ENABLED=true
# ---------------------------------------------------------------------------
PILOT_ACCESS_ENABLED=
PILOT_ACCESS_USERNAME=
PILOT_ACCESS_PASSWORD=

# ---------------------------------------------------------------------------
# Runtime (injected by Railway; do not hardcode in production)
# ---------------------------------------------------------------------------
PORT=
NODE_ENV=
