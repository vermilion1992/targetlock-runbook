# TargetLock Runbook — environment variable names only.
# Copy to .env.local for local overrides. Never commit real values.

# ---------------------------------------------------------------------------
# Optional client display base URL (safe for NEXT_PUBLIC_ exposure)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Inherited template AI demos (optional; not required for TargetLock pilot)
# Gemini credentials are server-only.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# In production, inherited template pages and APIs are disabled by default.
ENABLE_TEMPLATE_DEMOS=

# ---------------------------------------------------------------------------
# Runtime mode
# - demo: existing local operator selection and device-local repositories
# - pilot: server accounts/devices/leases plus local operation outbox and
#   audit/backup-only Postgres journal (not server domain materialisation)
# Production must set this explicitly. Never expose these values with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
TARGETLOCK_MODE=

# Secure controlled-pilot runtime (required when TARGETLOCK_MODE=pilot)
DATABASE_URL=
# disable/unset for Railway private networking; require encrypts without CA
# identity verification; verify-ca requires DATABASE_CA_CERT.
DATABASE_SSL=
DATABASE_CA_CERT=
PILOT_SESSION_SECRET=
PILOT_SESSION_TTL_SECONDS=
APP_ORIGIN=

# Initial one-time company administrator bootstrap. Set only while running
# `npm run pilot:bootstrap`, then remove these variables from the service.
PILOT_BOOTSTRAP_ORG_SLUG=
PILOT_BOOTSTRAP_ORG_NAME=
PILOT_BOOTSTRAP_ADMIN_EMAIL=
PILOT_BOOTSTRAP_ADMIN_NAME=
PILOT_BOOTSTRAP_ADMIN_PASSWORD=

# One-time password reset via `npm run pilot:reset-password`. Remove after use.
PILOT_RESET_EMAIL=
PILOT_RESET_PASSWORD=

# CI/local integration database only. `npm run test:pilot-db` fails clearly
# when this is absent and must never target production.
TEST_DATABASE_URL=

# Explicit local/demo build escape hatch. Do not set on a public pilot service.
ALLOW_LOCAL_DEMO_IN_PRODUCTION=

# Local HTTP exception for private development only. Railway pilot URLs use HTTPS.
ALLOW_INSECURE_PILOT_HTTP=

# Legacy whole-deployment Basic gate for demo previews only. Secure pilot mode
# uses account sessions and ignores this gate.
PILOT_ACCESS_ENABLED=
PILOT_ACCESS_USERNAME=
PILOT_ACCESS_PASSWORD=

# ---------------------------------------------------------------------------
# Runtime (injected by Railway; do not hardcode in production)
# ---------------------------------------------------------------------------
PORT=
NODE_ENV=
